{
  "name": "dnf-auction-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "던전앤파이터 경매장 시세 추적·예측",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "init": "node --env-file=.env --experimental-sqlite --no-warnings scripts/init-db.ts",
    "collect": "node --env-file=.env --experimental-sqlite --no-warnings src/collect-loop.ts",
    "collect:once": "node --env-file=.env --experimental-sqlite --no-warnings src/collect.ts",
    "stats": "node --env-file=.env --experimental-sqlite --no-warnings scripts/stats.ts",
    "probe": "node --env-file=.env --no-warnings scripts/probe.ts"
  }
}
