# https://developers.neople.co.kr 마이페이지에서 애플리케이션 등록 후 발급
NEOPLE_API_KEY=

# Supabase > Project Settings > Database의 Session pooler 연결 문자열
# Direct connection은 IPv6 전용이라 IPv4인 GitHub Actions에서는 Session pooler를 쓴다.
# 비밀번호의 특수문자는 percent-encode한다: @ -> %40, ! -> %21
DATABASE_URL=

# GitHub fine-grained PAT. Supabase Vault의 gh_dispatch_token 등록에 사용한다.
# dnf-price-tracker 저장소의 Actions: write 권한이 필요하다.
GH_DISPATCH_TOKEN=

# 1회성 SQLite -> Postgres 이관에만 사용한다. 새 설치에서는 필요 없다.
SQLITE_PATH=data/dnf.db
